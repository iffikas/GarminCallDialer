<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnBackground"
            android:text="@string/app_permissions" />

        <TextView
            style="@style/CardHint"
            android:layout_marginTop="8dp"
            android:text="@string/permissions_intro" />

        <!-- Phone calls -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/PermissionRow">

                <LinearLayout style="@style/PermissionText">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/perm_call" />

                    <TextView
                        style="@style/CardHint"
                        android:text="@string/perm_call_why" />

                    <TextView
                        android:id="@+id/callState"
                        style="@style/PermissionState" />
                </LinearLayout>

                <Button
                    android:id="@+id/callButton"
                    style="@style/PermissionButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bluetooth -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/PermissionRow">

                <LinearLayout style="@style/PermissionText">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/perm_bluetooth" />

                    <TextView
                        style="@style/CardHint"
                        android:text="@string/perm_bluetooth_why" />

                    <TextView
                        android:id="@+id/bluetoothState"
                        style="@style/PermissionState" />
                </LinearLayout>

                <Button
                    android:id="@+id/bluetoothButton"
                    style="@style/PermissionButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notifications (optional) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/PermissionRow">

                <LinearLayout style="@style/PermissionText">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/perm_notifications" />

                    <TextView
                        style="@style/CardHint"
                        android:text="@string/perm_notifications_why" />

                    <TextView
                        android:id="@+id/notificationsState"
                        style="@style/PermissionState" />
                </LinearLayout>

                <Button
                    android:id="@+id/notificationsButton"
                    style="@style/PermissionButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Battery optimisation -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/PermissionRow">

                <LinearLayout style="@style/PermissionText">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/perm_battery" />

                    <TextView
                        style="@style/CardHint"
                        android:text="@string/perm_battery_why" />

                    <TextView
                        android:id="@+id/batteryState"
                        style="@style/PermissionState" />
                </LinearLayout>

                <Button
                    android:id="@+id/batteryButton"
                    style="@style/PermissionButton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/CardHint"
            android:layout_marginTop="16dp"
            android:text="@string/permissions_revoke_hint" />
    </LinearLayout>
</ScrollView>
